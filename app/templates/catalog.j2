{% extends "base.j2" %}
{% set title = "App catalog" %}
{% set alpine_data = "catalogData" %}
{% block content %}

<div class="flex flex-col gap-y-6">

    <!-- Header -->
    <div class="flex items-center gap-x-3 mt-2">
        {% if not current_user.is_authenticated %}
        <img width="61" height="40" src="{{ url_for('static', filename='img/wingetty_small.png') }}" alt="WinGetty"
            class="h-10 w-auto">
        {% endif %}
        <div>
            <h1 class="text-3xl font-medium text-gray-800 dark:text-gray-200">{{ repo_name }} app catalog</h1>
            <p class="text-gray-500 dark:text-gray-400">Browse the apps available on this private winget source and
                install them with winget. Click a card for more details.</p>
        </div>
    </div>

    <!-- One-time source setup -->
    <div class="bg-white dark:bg-neutral-900 rounded-2xl shadow p-4 flex flex-col gap-y-2">
        <h2 class="text-lg font-semibold text-gray-800 dark:text-gray-200">One-time setup</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400">Register this source with winget once per machine. After
            that, the install buttons and commands below work directly.</p>
        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
            <code
                class="flex-1 text-sm bg-gray-100 dark:bg-neutral-950 text-gray-800 dark:text-gray-200 rounded-lg px-3 py-2 overflow-x-auto whitespace-nowrap"
                x-text="sourceAddCommand"></code>
            <button type="button" @click="copy(sourceAddCommand, 'Setup command copied')"
                class="flex items-center justify-center px-3 py-1.5 text-sm text-white transition-colors duration-300 bg-blue-600 rounded-lg shrink-0 gap-x-2 hover:bg-blue-500">
                <svg class="h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M8.25 7.5V6.108c0-1.135.845-2.098 1.976-2.192.373-.03.748-.057 1.123-.08M15.75 18H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08M15.75 18.75v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5A3.375 3.375 0 006.375 7.5H5.25m11.9-3.664A2.251 2.251 0 0015 2.25h-1.5a2.251 2.251 0 00-2.15 1.586m5.8 0c.065.21.1.433.1.664v.75h-6V4.5c0-.231.035-.454.1-.664M6.75 7.5H4.875c-.621 0-1.125.504-1.125 1.125v12c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V16.5a9 9 0 00-9-9z" />
                </svg>
                <span>Copy</span>
            </button>
        </div>
    </div>

    <!-- Search -->
    <div class="relative flex items-center">
        <span class="absolute">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                stroke="currentColor" class="w-5 h-5 mx-3 text-gray-400">
                <path stroke-linecap="round" stroke-linejoin="round"
                    d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
            </svg>
        </span>
        <input type="text" placeholder="Search apps" x-model="search" @input.debounce.400ms="fetchPackages()"
            class="block w-full py-1.5 pr-5 text-gray-700 dark:text-gray-200 bg-white dark:bg-neutral-900 rounded-lg md:w-96 placeholder-gray-400/70 pl-11 rtl:pr-11 rtl:pl-5 focus:border-blue-400 focus:ring-blue-300 focus:outline-none focus:ring focus:ring-opacity-40">
    </div>

    <!-- Package cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" x-show="!loading" x-cloak>
        <template x-for="package in packages" :key="package.identifier">
            <div class="bg-white dark:bg-neutral-900 rounded-2xl shadow p-4 flex flex-col gap-y-3 cursor-pointer transition-shadow hover:shadow-md focus:outline-none focus:ring focus:ring-blue-300 focus:ring-opacity-50"
                role="button" tabindex="0" :aria-label="'Show details for ' + package.name"
                @click="detailsPkg = package"
                @keydown.enter.prevent="detailsPkg = package"
                @keydown.space.prevent="detailsPkg = package">
                <div class="flex items-start justify-between gap-x-2">
                    <div class="min-w-0">
                        <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-200 truncate"
                            x-text="package.name"></h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400 truncate"
                            x-text="package.publisher + ' · ' + package.identifier"></p>
                    </div>
                    <span
                        class="px-3 py-1 text-sm rounded-full bg-emerald-100/60 dark:bg-emerald-700/60 text-emerald-600 dark:text-emerald-300 shrink-0"
                        x-text="'v' + package.latest_version"></span>
                </div>
                <p class="text-sm text-gray-600 dark:text-gray-300" x-text="package.description"></p>
                <div class="flex items-center gap-2 mt-auto flex-wrap" @click.stop>
                    {% if protocol_enabled %}
                    <a :href="protocolUrl(package)"
                        class="flex items-center justify-center px-3 py-1.5 text-sm text-white transition-colors duration-300 bg-blue-600 rounded-lg gap-x-2 hover:bg-blue-500">
                        <svg class="h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                            stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                        </svg>
                        <span>Install</span>
                    </a>
                    {% endif %}
                    <button type="button" @click="copy(installCommand(package), 'Install command copied')"
                        class="flex items-center justify-center px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 transition-colors duration-300 bg-gray-100 dark:bg-neutral-800 rounded-lg gap-x-2 hover:bg-gray-200 dark:hover:bg-neutral-700">
                        <svg class="h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                            stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M8.25 7.5V6.108c0-1.135.845-2.098 1.976-2.192.373-.03.748-.057 1.123-.08M15.75 18H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08M15.75 18.75v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5A3.375 3.375 0 006.375 7.5H5.25m11.9-3.664A2.251 2.251 0 0015 2.25h-1.5a2.251 2.251 0 00-2.15 1.586m5.8 0c.065.21.1.433.1.664v.75h-6V4.5c0-.231.035-.454.1-.664M6.75 7.5H4.875c-.621 0-1.125.504-1.125 1.125v12c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V16.5a9 9 0 00-9-9z" />
                        </svg>
                        <span>Copy command</span>
                    </button>
                    <button type="button" @click.stop="selected = package"
                        class="px-3 py-1.5 text-sm text-blue-600 dark:text-blue-300 hover:underline">
                        Versions
                    </button>
                </div>
            </div>
        </template>
    </div>

    <div x-show="!loading && packages.length === 0" x-cloak
        class="text-center text-gray-500 dark:text-gray-400 py-10">
        No apps found.
    </div>

    <!-- Pagination -->
    <div class="mt-2 sm:flex sm:items-center sm:justify-between" x-show="!loading && totalPages > 1" x-cloak>
        <div class="text-sm text-gray-500 dark:text-gray-300">
            Page <span class="font-medium text-gray-700 dark:text-gray-300" x-text="currentPage"></span> of <span
                x-text="totalPages"></span>
        </div>
        <div class="flex items-center mt-4 gap-x-4 sm:mt-0">
            <button x-show="currentPage > 1" @click="currentPage--; fetchPackages();"
                class="flex items-center justify-center px-5 py-2 text-sm text-gray-700 dark:text-gray-300 transition-colors duration-300 bg-white dark:bg-neutral-950 dark:hover:bg-neutral-900 rounded-md gap-x-2 hover:bg-gray-100">
                Previous
            </button>
            <button x-show="currentPage < totalPages" @click="currentPage++; fetchPackages();"
                class="flex items-center justify-center px-5 py-2 text-sm text-gray-700 dark:text-gray-300 transition-colors duration-300 bg-white dark:bg-neutral-950 dark:hover:bg-neutral-900 rounded-md gap-x-2 hover:bg-gray-100">
                Next
            </button>
        </div>
    </div>

    <!-- Details modal (clicking a card) -->
    <div x-cloak x-show="detailsPkg !== null" @keydown.escape.window="detailsPkg = null"
        class="fixed top-0 left-0 right-0 z-50 w-full p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-full max-h-full dark:bg-neutral-700/40 flex justify-center items-center">
        <div class="relative w-full max-w-lg" @click.away="detailsPkg = null">
            <div class="relative bg-white rounded-2xl shadow dark:bg-neutral-900 p-4 flex flex-col gap-y-3 max-h-[85vh] overflow-y-auto"
                role="dialog" aria-modal="true" :aria-label="detailsPkg ? 'Details for ' + detailsPkg.name : ''">
                <div class="flex items-start justify-between gap-x-2">
                    <div class="min-w-0">
                        <h3 class="text-xl font-semibold text-gray-900 dark:text-white"
                            x-text="detailsPkg ? detailsPkg.name : ''"></h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400"
                            x-text="detailsPkg ? detailsPkg.publisher + ' · ' + detailsPkg.identifier + ' · v' + detailsPkg.latest_version : ''">
                        </p>
                    </div>
                    <button type="button" @click="detailsPkg = null" aria-label="Close details"
                        class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 ml-auto inline-flex items-center dark:hover:bg-gray-600 dark:hover:text-white shrink-0">
                        <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"
                            xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd"
                                d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293-4.293a1 1 0 01-1.414-1.414L10 4.293 5.707 4.293 4.293 4.293z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </button>
                </div>

                <p class="text-sm text-gray-600 dark:text-gray-300 whitespace-pre-line"
                    x-text="detailsPkg ? (detailsPkg.details.description || detailsPkg.description) : ''"></p>

                <div class="flex flex-wrap gap-2" x-show="detailsPkg && detailsPkg.details.tags">
                    <template x-for="tag in (detailsPkg && detailsPkg.details.tags ? detailsPkg.details.tags : [])"
                        :key="tag">
                        <span
                            class="px-2 py-0.5 text-xs rounded-full bg-blue-100/70 dark:bg-blue-900/50 text-blue-700 dark:text-blue-200"
                            x-text="tag"></span>
                    </template>
                </div>

                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2"
                    x-show="detailsPkg && detailsFacts(detailsPkg).length > 0">
                    <template x-for="fact in (detailsPkg ? detailsFacts(detailsPkg) : [])" :key="fact.label">
                        <div class="bg-gray-50 dark:bg-neutral-950 rounded-lg px-3 py-2">
                            <dt class="text-xs uppercase tracking-wide text-gray-400 dark:text-gray-500"
                                x-text="fact.label"></dt>
                            <dd class="text-sm text-gray-800 dark:text-gray-200 break-words" x-text="fact.value">
                            </dd>
                        </div>
                    </template>
                </dl>

                <div class="flex flex-wrap gap-2" x-show="detailsPkg && detailsLinks(detailsPkg).length > 0">
                    <template x-for="link in (detailsPkg ? detailsLinks(detailsPkg) : [])" :key="link.label">
                        <a :href="link.url" target="_blank" rel="noopener noreferrer"
                            class="px-3 py-1.5 text-sm text-blue-600 dark:text-blue-300 bg-blue-50 dark:bg-blue-900/30 rounded-lg hover:underline"
                            x-text="link.label"></a>
                    </template>
                </div>

                <template x-if="detailsPkg && detailsPkg.details.installation_notes">
                    <details class="text-sm bg-gray-50 dark:bg-neutral-950 rounded-lg px-3 py-2">
                        <summary class="cursor-pointer text-blue-600 dark:text-blue-300 hover:underline">Installation
                            notes</summary>
                        <p class="mt-1 text-gray-600 dark:text-gray-300 whitespace-pre-line"
                            x-text="detailsPkg ? detailsPkg.details.installation_notes : ''"></p>
                    </details>
                </template>

                <template x-if="detailsPkg && detailsPkg.details.release_notes">
                    <details class="text-sm bg-gray-50 dark:bg-neutral-950 rounded-lg px-3 py-2">
                        <summary class="cursor-pointer text-blue-600 dark:text-blue-300 hover:underline">Release
                            notes</summary>
                        <p class="mt-1 text-gray-600 dark:text-gray-300 whitespace-pre-line"
                            x-text="detailsPkg ? detailsPkg.details.release_notes : ''"></p>
                    </details>
                </template>

                <p class="text-xs text-gray-400 dark:text-gray-500"
                    x-text="detailsPkg ? 'Details from the winget manifest of version ' + detailsPkg.latest_version : ''">
                </p>

                <div class="flex items-center gap-2 flex-wrap border-t border-gray-100 dark:border-neutral-800 pt-3">
                    {% if protocol_enabled %}
                    <a :href="detailsPkg ? protocolUrl(detailsPkg) : '#'"
                        class="flex items-center justify-center px-3 py-1.5 text-sm text-white transition-colors duration-300 bg-blue-600 rounded-lg gap-x-2 hover:bg-blue-500">
                        <span>Install</span>
                    </a>
                    {% endif %}
                    <button type="button"
                        @click="detailsPkg && copy(installCommand(detailsPkg), 'Install command copied')"
                        class="px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 transition-colors duration-300 bg-gray-100 dark:bg-neutral-800 rounded-lg hover:bg-gray-200 dark:hover:bg-neutral-700">
                        Copy command
                    </button>
                    <button type="button" @click="selected = detailsPkg; detailsPkg = null"
                        class="px-3 py-1.5 text-sm text-blue-600 dark:text-blue-300 hover:underline">
                        All versions
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Versions modal -->
    <div x-cloak x-show="selected !== null" @keydown.escape.window="selected = null"
        class="fixed top-0 left-0 right-0 z-50 w-full p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-full max-h-full dark:bg-neutral-700/40 flex justify-center items-center">
        <div class="relative w-full max-w-lg" @click.away="selected = null">
            <div class="relative bg-white rounded-2xl shadow dark:bg-neutral-900 p-4 flex flex-col gap-y-3">
                <div class="flex items-start justify-between">
                    <h3 class="text-xl font-semibold text-gray-900 dark:text-white"
                        x-text="selected ? selected.name : ''"></h3>
                    <button type="button" @click="selected = null"
                        class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 ml-auto inline-flex items-center dark:hover:bg-gray-600 dark:hover:text-white">
                        <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"
                            xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd"
                                d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293-4.293a1 1 0 01-1.414-1.414L10 4.293 5.707 4.293 4.293 4.293z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </button>
                </div>
                <template x-for="version in (selected ? selected.versions : [])" :key="version">
                    <div class="bg-gray-50 dark:bg-neutral-950 rounded-lg px-3 py-2 flex flex-col gap-y-2">
                        <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                            <span class="text-sm font-medium text-gray-800 dark:text-gray-200 flex-1"
                                x-text="'Version ' + version"></span>
                            <div class="flex gap-2">
                                {% if protocol_enabled %}
                                <a :href="protocolUrl(selected, version)"
                                    class="px-3 py-1 text-sm text-white bg-blue-600 rounded-lg hover:bg-blue-500 transition-colors duration-300">Install</a>
                                {% endif %}
                                <button type="button" @click="copy(installCommand(selected, version), 'Install command copied')"
                                    class="px-3 py-1 text-sm text-gray-700 dark:text-gray-200 bg-gray-200 dark:bg-neutral-800 rounded-lg hover:bg-gray-300 dark:hover:bg-neutral-700 transition-colors duration-300">Copy
                                    command</button>
                            </div>
                        </div>
                        <template x-if="selected && versionReleaseNotes(selected, version)">
                            <details class="text-sm">
                                <summary
                                    class="cursor-pointer text-blue-600 dark:text-blue-300 hover:underline">Release
                                    notes</summary>
                                <p class="mt-1 text-gray-600 dark:text-gray-300 whitespace-pre-line"
                                    x-text="selected ? versionReleaseNotes(selected, version) : ''"></p>
                            </details>
                        </template>
                    </div>
                </template>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('catalogData', () => ({
            packages: [],
            total: 0,
            currentPage: 1,
            perPage: 24,
            search: '',
            loading: true,
            selected: null,
            detailsPkg: null,
            sourceName: {{ source_name | tojson }},
            protocolScheme: {{ protocol_scheme | tojson }},
            sourceAddCommand: `winget source add -n {{ source_name }} -t "Microsoft.Rest" -a {{ url_for('winget.index', _external=True, _scheme="https") }}`,
            async init() {
                await this.fetchPackages();
            },
            async fetchPackages() {
                let resp = await fetch(`{{ url_for('catalog.packages') }}?page=${this.currentPage}&limit=${this.perPage}&search=${encodeURIComponent(this.search)}`);
                let data = await resp.json();
                this.packages = data.packages;
                this.total = data.total;
                this.currentPage = data.current_page;
                this.loading = false;
            },
            installCommand(package_, version = null) {
                let cmd = `winget install --exact --id ${package_.identifier} --source ${this.sourceName}`;
                if (version) {
                    cmd += ` --version ${version}`;
                }
                return cmd;
            },
            protocolUrl(package_, version = null) {
                let url = `${this.protocolScheme}://install/${encodeURIComponent(package_.identifier)}?source=${encodeURIComponent(this.sourceName)}`;
                if (version) {
                    url += `&version=${encodeURIComponent(version)}`;
                }
                return url;
            },
            async copy(text, message) {
                try {
                    await navigator.clipboard.writeText(text);
                } catch (e) {
                    let textarea = document.createElement('textarea');
                    textarea.value = text;
                    document.body.appendChild(textarea);
                    textarea.select();
                    document.execCommand('copy');
                    document.body.removeChild(textarea);
                }
                window.dispatchEvent(new CustomEvent('notice', {
                    detail: { text: message, type: 'success' }
                }));
            },
            // Only http(s) URLs may become links; everything else is dropped.
            safeUrl(url) {
                return (typeof url === 'string' && /^https?:\/\//i.test(url)) ? url : null;
            },
            detailsFacts(package_) {
                let d = (package_ && package_.details) || {};
                let facts = [];
                let fields = [
                    ['author', 'Author'],
                    ['license', 'License'],
                    ['copyright', 'Copyright'],
                    ['moniker', 'Moniker'],
                    ['release_date', 'Release date'],
                ];
                for (let [key, label] of fields) {
                    if (d[key]) facts.push({ label, value: d[key] });
                }
                return facts;
            },
            detailsLinks(package_) {
                let d = (package_ && package_.details) || {};
                let links = [];
                let fields = [
                    ['homepage', 'Homepage'],
                    ['publisher_url', 'Publisher'],
                    ['publisher_support_url', 'Support'],
                    ['privacy_url', 'Privacy'],
                    ['license_url', 'License'],
                    ['copyright_url', 'Copyright'],
                    ['purchase_url', 'Purchase'],
                    ['release_notes_url', 'Release notes'],
                ];
                for (let [key, label] of fields) {
                    let url = this.safeUrl(d[key]);
                    if (url) links.push({ label, url });
                }
                for (let doc of (d.documentations || [])) {
                    let url = this.safeUrl(doc.url);
                    if (url) links.push({ label: doc.label || 'Documentation', url });
                }
                return links;
            },
            versionReleaseNotes(package_, version) {
                let vd = (package_ && package_.version_details) || {};
                return (vd[version] && vd[version].release_notes) || null;
            },
            get totalPages() {
                return Math.ceil(this.total / this.perPage);
            },
        }))
    });
</script>
{% endblock %}
